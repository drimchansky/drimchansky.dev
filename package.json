{
  "name": "drimchansky.dev",
  "type": "module",
  "version": "2.0.0",
  "packageManager": "pnpm@11.6.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "env": "[ -f .env ] || cp .env.example .env",
    "lfs": "git-lfs pull",
    "test:e2e": "sh scripts/test.sh tests/e2e",
    "test:visual": "sh scripts/test.sh tests/visual",
    "test:visual:update": "sh scripts/test.sh tests/visual --update-snapshots",
    "test:unit": "vitest run",
    "lint": "astro check && eslint .",
    "format": "prettier --write . && eslint --fix .",
    "test": "pnpm lint && pnpm test:unit && sh scripts/test.sh"
  },
  "browserslist": [
    "last 2 version",
    "not dead"
  ],
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/markdown-remark": "7.3.1",
    "@astrojs/mdx": "8.0.2",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.5",
    "astro-icon": "1.2.0",
    "date-fns": "4.4.0",
    "dotenv": "18.0.4",
    "focus-trap": "8.2.2",
    "markdown-it": "15.0.2",
    "rehype-autolink-headings": "7.1.0",
    "rehype-external-links": "3.0.0",
    "rehype-slug": "6.0.0",
    "sanitize-html": "2.17.7",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "@types/sanitize-html": "2.16.2",
    "@typescript-eslint/parser": "8.71.0",
    "astro-eslint-parser": "3.2.0",
    "eslint": "10.11.0",
    "eslint-config-standard": "17.1.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-n": "18.4.0",
    "eslint-plugin-perfectionist": "5.12.1",
    "eslint-plugin-promise": "7.3.0",
    "postcss-html": "2.0.0",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "stylelint": "17.15.0",
    "stylelint-config-html": "2.0.0",
    "stylelint-config-idiomatic-order": "10.0.0",
    "stylelint-config-recommended": "18.0.0",
    "stylelint-order": "8.1.1",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
