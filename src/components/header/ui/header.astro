---
import Container from '@/shared/ui/container.astro'
import SkipLink from '@/shared/ui/skip-link.astro'

import Hamburger from './hamburger.astro'
import Menu from './menu.astro'
---

<SkipLink />

<header
  class="border-header-border bg-header z-1 h-(--header-height) border-b print:hidden"
  id="header"
  transition:animate="none"
>
  <Container class="flex items-center justify-between sm:gap-8">
    <Menu id="menu" />
    <Hamburger aria-expanded="false" id="hamburger-button" />
  </Container>
</header>

<script>
  import type { FocusTrap } from 'focus-trap'
  ;(() => {
    let focusTrap: FocusTrap | undefined
    let closeMenu: ((returnFocus?: boolean) => void) | undefined

    const menuMedia = matchMedia('(max-width: 767px)')
    menuMedia.addEventListener('change', event => {
      const expanded = document.getElementById('hamburger-button')?.getAttribute('aria-expanded') === 'true'
      if (!event.matches && expanded) {
        closeMenu?.()
      }
    })

    const onPageLoaded = () => {
      const page = document.documentElement
      const header = document.getElementById('header')!
      const button = document.getElementById('hamburger-button')!
      const menu = document.getElementById('menu')!
      const main = document.getElementById('main')
      const skipLink = document.querySelector('a[href="#main"]')

      let trapPromise: Promise<FocusTrap> | undefined
      const getFocusTrap = () => {
        trapPromise ??= import('focus-trap')
          .then(({ createFocusTrap }) => {
            focusTrap = createFocusTrap(header, { initialFocus: false, onDeactivate: () => closeMenu?.() })
            return focusTrap
          })
          .catch((error: unknown) => {
            // Clear the memo so a failed chunk load is not kept as a rejected promise, which would leave
            // every later open untrapped with no retry.
            trapPromise = undefined
            throw error
          })
        return trapPromise
      }

      function isMenuOpened() {
        return button.getAttribute('aria-expanded') === 'true'
      }

      const openMenu = async () => {
        page.classList.add('clip')
        main?.setAttribute('inert', '')
        skipLink?.setAttribute('inert', '')

        button.setAttribute('aria-expanded', 'true')

        menu.classList.remove('menu--closed')
        menu.classList.add('menu--opened')

        try {
          const trap = await getFocusTrap()
          if (isMenuOpened()) {
            trap.activate()
          }
        } catch {
          // The menu is already open and #main already inert here, so a failed focus-trap import degrades
          // to an untrapped menu instead of rejecting and stranding the page mid-open.
        }
      }

      closeMenu = (returnFocus = true) => {
        page.classList.remove('clip')
        main?.removeAttribute('inert')
        skipLink?.removeAttribute('inert')

        button.setAttribute('aria-expanded', 'false')

        menu.classList.remove('menu--opened')
        menu.classList.add('menu--closed')

        focusTrap?.deactivate({ returnFocus })
      }

      button.addEventListener('click', () => {
        isMenuOpened() ? closeMenu?.() : void openMenu()
      })
    }

    if (document.readyState === 'loading') {
      window.addEventListener('DOMContentLoaded', onPageLoaded)
    } else {
      onPageLoaded()
    }
    document.addEventListener('astro:after-swap', onPageLoaded)

    document.addEventListener('astro:before-swap', () => {
      closeMenu?.(false)
    })
  })()
</script>
