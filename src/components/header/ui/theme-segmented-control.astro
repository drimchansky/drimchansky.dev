---
import { t, type LocaleCollection } from '@/app/i18n'
import { colorThemeValues, THEME_STORAGE_KEY } from '@/shared/constants'
import { getTestId } from '@/shared/functions/getTestId'
import TypographySpan from '@/shared/ui/typography/typography-span.astro'
---

<fieldset
  data-testid={getTestId('theme-segmented-control')}
  id="theme-segmented-control"
  class="m-0 border-none p-0"
  disabled
>
  <legend class="visually-hidden"><span data-nosnippet>{t(Astro.currentLocale, 'theme')}</span></legend>

  <div class="border-switcher-border bg-switcher text-switcher-fg flex rounded-full border p-1" id="theme-options">
    {
      colorThemeValues.map(value => (
        <label class="relative">
          <input
            data-testid={getTestId(`set-${value}-theme-button`)}
            class="peer focus-ring absolute inset-0 z-1 m-0 box-border h-full w-full cursor-pointer appearance-none rounded-[20px] border-0 bg-transparent checked:cursor-default disabled:cursor-not-allowed checked:disabled:cursor-default"
            name="color-theme"
            type="radio"
            value={value}
          />
          <TypographySpan
            data-nosnippet
            class="peer-checked:bg-switcher-active can-hover:peer-hover:opacity-100 m-0 block appearance-none rounded-full border-0 bg-transparent px-3 py-1.5 leading-none text-inherit opacity-70 peer-checked:opacity-100"
          >
            {t(Astro.currentLocale, value as keyof LocaleCollection)}
          </TypographySpan>
        </label>
      ))
    }
  </div>
</fieldset>

<script is:inline define:vars={{ themeStorageKey: THEME_STORAGE_KEY, themeValues: colorThemeValues }}>
  ;(() => {
    function updateSwitcherStateAfterNavigation() {
      const themeOptionsElement = document.getElementById('theme-options')
      if (!themeOptionsElement) return

      const stored = localStorage.getItem(themeStorageKey)
      const theme = themeValues.includes(stored) ? stored : 'auto'

      const input = themeOptionsElement.querySelector(`[value="${theme}"]`)
      if (input) input.checked = true
    }

    updateSwitcherStateAfterNavigation()
    document.addEventListener('astro:after-swap', updateSwitcherStateAfterNavigation)
  })()
</script>

<script>
  import { colorThemeValues, THEME_CLASSES, THEME_STORAGE_KEY, type ColorTheme } from '@/shared/constants'

  const isColorTheme = (value: string | null): value is ColorTheme =>
    !!value && (colorThemeValues as readonly string[]).includes(value)

  const applyTheme = (theme: ColorTheme) => {
    const switcherElement = document.getElementById('theme-segmented-control')! as HTMLFieldSetElement
    const themeOptionsElement = switcherElement.querySelector('#theme-options')!

    const input = themeOptionsElement.querySelector(`[value="${theme}"]`) as HTMLInputElement | null
    if (input) input.checked = true

    document.documentElement.classList.toggle(THEME_CLASSES['dark'], theme === 'dark')
    document.documentElement.classList.toggle(THEME_CLASSES['light'], theme === 'light')
  }

  const onThemeChange = (event: Event) => {
    const target = event.target as HTMLInputElement
    const newTheme = target.value

    if (!isColorTheme(newTheme)) return

    localStorage.setItem(THEME_STORAGE_KEY, newTheme)
    applyTheme(newTheme)
  }

  const onStorageChange = (event: StorageEvent) => {
    if (event.key !== THEME_STORAGE_KEY) return

    const newTheme = event.newValue
    if (!isColorTheme(newTheme)) return

    applyTheme(newTheme)
  }

  const onPageLoaded = () => {
    const switcherElement = document.getElementById('theme-segmented-control')! as HTMLFieldSetElement
    const themeOptionsElement = switcherElement.querySelector('#theme-options')!

    switcherElement.disabled = false
    themeOptionsElement.addEventListener('change', onThemeChange)
  }

  // Module scripts can execute after DOMContentLoaded has already fired
  if (document.readyState === 'loading') {
    window.addEventListener('DOMContentLoaded', onPageLoaded)
  } else {
    onPageLoaded()
  }
  window.addEventListener('storage', onStorageChange)
  document.addEventListener('astro:after-swap', onPageLoaded)
</script>
