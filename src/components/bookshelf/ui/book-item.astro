---
import type { ImageMetadata } from 'astro'

import { Picture } from 'astro:assets'

import type { Locale } from '@/app/i18n'

import { t } from '@/app/i18n'

import type { PageEstimateMethod } from '../functions/pageEstimateSchema'

import { getBookText } from '../functions/getBookText'
import BookPageEstimate from './book-page-estimate.astro'
import StarRating from './star-rating.astro'

interface Props {
  author: { en: string; ru: string }
  cover: ImageMetadata
  descriptionHtml?: string
  id: string
  language: Locale
  locale: Locale
  pageEstimate?: number
  pageEstimateMethod?: PageEstimateMethod
  rating: number | null
  skipped?: boolean
  title: { en: string; ru: string }
  type: 'fiction' | 'non-fiction'
}

const {
  author,
  cover,
  descriptionHtml,
  id,
  language,
  locale,
  pageEstimate,
  pageEstimateMethod,
  rating,
  skipped,
  title,
  type
} = Astro.props

const displayTitle = getBookText(title, locale)
const displayAuthor = getBookText(author, locale)
const langLabels = { en: 'langEn', ru: 'langRu' } as const
---

<li class="flex items-start gap-4 py-3" data-type={type} data-book-id={id}>
  <Picture
    src={cover}
    formats={['avif', 'webp']}
    alt={displayTitle}
    class="border-border-strong h-auto w-16 shrink-0 rounded-sm border object-cover"
    width={64}
    densities={[1.5, 2]}
    loading="lazy"
    quality={80}
  />

  <div class="flex min-w-0 flex-1 flex-col gap-0.5">
    <span class="text-fg font-sans text-base leading-snug font-medium">
      {displayTitle}
    </span>
    <span class="text-fg-subtle text-sm">
      {displayAuthor}
    </span>
    <div class="mt-0.5 flex flex-wrap items-center gap-2">
      {!skipped && <StarRating rating={rating} />}
      <span class="text-fg-subtle bg-surface border-border-strong rounded border px-1.5 py-0 text-xs leading-relaxed">
        {t(locale, langLabels[language])}
      </span>
      {
        skipped && (
          <span class="text-fg-subtle bg-surface border-border-strong rounded border px-1.5 py-0 text-xs leading-relaxed">
            {t(locale, 'skipped')}
          </span>
        )
      }
      <BookPageEstimate
        id={id}
        locale={locale}
        pageEstimate={pageEstimate}
        pageEstimateMethod={pageEstimateMethod}
        title={displayTitle}
      />
    </div>
    {
      descriptionHtml && (
        <div
          class="text-fg-muted mt-2 max-w-prose text-sm leading-relaxed [&_a]:underline [&_ol]:list-decimal [&_ol]:pl-5 [&_p]:mt-2 [&_ul]:list-disc [&_ul]:pl-5 [&>*:first-child]:mt-0"
          set:html={descriptionHtml}
        />
      )
    }
  </div>
</li>
